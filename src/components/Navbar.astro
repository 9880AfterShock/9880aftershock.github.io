---
import Logo from "../assets/logo.svg";
import "../styles/global.scss";
interface Props {
    current: string;
}

const { current } = Astro.props;
---

<nav class="navbar md:navbar-expand sticky-top bg-1 fg-2">
    <div class="container-fluid">
        <div class="navbar-brand d-inline-flex p-2 gap-3 place-items-stretch">
                <Logo width={70} height={70}/>
                <p class="fs-xl align-middle align-self-center mb-0 fg-1">
                    Aftershock
                </p>
        </div>

        <button class="btn-icon navbar-toggler" type="button" data-bs-toggle="drawer" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon" aria-hidden="true"></span>
        </button>
        <dialog class="drawer drawer-end" tabindex="-1" id="navbarNav" aria-labelledby="navbarNavLabel">
              <div class="drawer-header">
                <h5 class="drawer-title" id="navbarNavLabel">Menu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close"></button>
              </div>
              <div class="drawer-body">
                <ul class="navbar-nav ms-auto">
                  <li class="nav-item">
                      <button class:list={["btn-outline fs-lg",current === "Home" ? "fg-3 disabled" : ""]} aria-current={current === "Home" ? "true" : undefined} type="button" hx-swap="outerHTML swap:0.3s" hx-get="/home" hx-target="#content">Home</button>
                  </li>
                  <li class="nav-item">
                      <button class:list={["btn-outline fs-lg",current === "About" ? "fg-3 disabled" : ""]} aria-current={current === "About" ? "true" : undefined} type="button" hx-swap="outerHTML swap:0.3s" hx-get="/about" hx-target="#content">About</button>
                  </li>
                  <li class="nav-item">
                    <button class:list={["btn-outline fs-lg",current === "Highlights" ? "fg-3 disabled" : ""]} aria-current={current === "Highlights" ? "true" : undefined} type="button" hx-swap="outerHTML swap:0.3s" hx-get="/highlights" hx-target="#content">Highlights</button>
                  </li>
                  <li class="nav-item">
                    <button class:list={["btn-outline fs-lg",current === "Contact" ? "fg-3 disabled" : ""]} aria-current={current === "Contact" ? "true" : undefined} type="button" hx-swap="outerHTML swap:0.3s" hx-get="/contact" hx-target="#content">Contact</button>
                  </li>
                  <li class="nav-item">
                      <button class:list={["btn-outline fs-lg",current === "Donate" ? "fg-3 disabled" : ""]} aria-current={current === "Donate" ? "true" : undefined} type="button" hx-swap="outerHTML swap:0.3s" hx-get="/donate" hx-target="#content">Donate</button>
                  </li>
                  <li class="nav-item">
                      <button class:list={["btn-outline fs-lg",current === "Sponsors" ? "fg-3 disabled" : ""]} aria-current={current === "Sponsors" ? "true" : undefined} type="button" hx-swap="outerHTML swap:0.3s" hx-get="/sponsors" hx-target="#content">Sponsors</button>
                  </li>
                </ul>
              </div>
            </dialog>
        
    </div>
</nav>
