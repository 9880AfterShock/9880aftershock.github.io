---
import Navbar from '../components/Navbar.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
const photos = await getCollection('sponsor_photos');
const sponsors = await getCollection('sponsors');
import UrlFixer from '../components/UrlFixer.astro';
---
<div id="content">
    <Navbar current="Sponsors"/>
    <div class="transition fg-1 fs-lg">
        <div class="vstack">
        {
        sponsors.toReversed().map((sponsor, i) => 
                <div class:list={["d-flex bg-1", (i % 2 == 0) ? "sponsor-layout" : "sponsor-layout-reverse"]} style="margin-top: 2rem; margin-bottom: 2rem;">
                    <Image src={photos.find(photo => sponsor.data.photo.id == photo.id)?.data.image} alt={"First sponsors woohoo!"} style="width: 100%; height:auto; aspect-ratio: auto;"/>
                    <div class="vstack place-items-center align-content-center justify-content-center" style="width: 100%;">
                        <h3 class="fs-4xl fw-bold" style="padding: 2rem;">{sponsor.data.title}</h3>
                        <div style="max-width: 80rem; padding: 2rem;">
                            <Fragment set:html={sponsor.rendered?.html}/>
                        </div>
                    </div>
                </div>)
        }
        </div>
    </div>
</div>

<UrlFixer/>