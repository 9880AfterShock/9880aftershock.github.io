---
import { getCollection } from 'astro:content';
import text_logo from "../assets/logo_text.avif";
import { Image } from 'astro:assets';
import Navbar from '../components/Navbar.astro';
import { undefined } from 'astro:schema';
const images = await getCollection('home_carousel_images');
const events = await getCollection('events');
const event_photos = await getCollection('event_photos');
---
<div id="content">
    <Navbar current="Home"/>
    <div class="transition">
        <div class="d-flex justify-items-center justify-content-center z-toast" style="margin-bottom: -2rem; margin-top: -1.5rem;"><Image src = {text_logo} alt ="test"/></div>
        <div id="carouselMultiple" class="carousel slide" data-bs-ends="stop" style=" --carousel-items-gap: 0rem">
          <div class="d-flex justify-items-center justify-content-center place-items-center">
              <button class="btn-text fg-2 z-toast" type="button" data-bs-target="#carouselMultiple" data-bs-slide="prev" style="--bs-carousel-control-icon-width: 1rem; margin-right: 1rem; height: 15rem; width: 3rem;">
                <span class="carousel-icon-prev" aria-hidden="true"></span>
                <span class="visually-hidden fg-2">Previous</span>
              </button>
              <div class="carousel-inner">
                  {images.map((image, index) => (
                    <button data-bs-toggle="dialog" data-bs-target={"#" + image.id} type="button" class:list={["carousel-item bg-2", {active: index === 0}]} style="padding-bottom: 3rem; padding: 1rem; border-width: 0;"><Image src={image.data.image} alt="" class="hover-lift w-100 rounded-5" style="aspect-ratio: 1/1; object-fit: cover; height:100%;"/></button>
                  ))}
              </div>
              <button class="btn-text fg-2 z-toast" type="button" data-bs-target="#carouselMultiple" data-bs-slide="next" style="--bs-carousel-control-icon-width: 1rem; margin-left: 1rem; height: 15rem;  width: 3rem;">
                <span class="carousel-icon-next" aria-hidden="true"></span>
                <span class="visually-hidden fg-2">Next</span>
              </button>
          </div>
        </div>
        <div class="d-flex flex-column justify-items-center justify-content-center place-items-center fs-l" style="width: 100%;">
            <h1 class="fg-2 text-center fs-6xl">Meet Our Team</h1>
            <p class="fg-2 meet-team">We’re Aftershock 9880, a FIRST Tech Challenge robotics team from Edmonds Heights K-12 in Edmonds, WA. Our team of middle and high school students designs, builds, and programs custom robots. We combine innovation, teamwork, and STEM skills to compete at a high level.
            </p>
            
            <p class="fg-2 meet-team">
            Beyond the competitions, we’re committed to community outreach and STEM education, sharing the excitement of FIRST robotics programs and raising awareness about the impact of FIRST. From demos and workshops to mentoring younger teams, we strive to inspire the next generation of engineers and problem solvers.
            </p>
             
            <p class="fg-2 meet-team">
            At our unique alternative learning school, we thrive on hands-on experience, creativity, and collaboration.</p>
        </div>
        {images.map(image => (
          <dialog class="dialog w-fit" id={image.id}>
            <div class="dialog-header w-100">
                <h1 class="dialog-title">{image.id.split(".").at(0)?.replaceAll("_"," ")}</h1>
              <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Close"></button>
            </div>
            <div class="dialog-body">
                <Image src={image.data.image} alt=""/>
            </div>
          </dialog>
        ))}
        <div class="bg-1 d-flex place-items-center" style="height: 10rem; margin-top: 2rem; margin-bottom: 2rem;">
            <h1 class="fg-1 fs-6xl" style="margin-left: 5%; margin-right: 5%;">Upcoming Events</h1>
        </div>
        <div class="row row-cols-1 md:row-cols-3 g-4" style="margin-left: 5%; margin-right: 5%;">
            {events.map(event => (
              <div class="col">
                <div class="card">
                    <Image src={event_photos.find(image => image.id === event.data.image.id)?.data.image} class="card-img-top" alt={event.data.alt} style="aspect-ratio: 1/1; object-fit: cover; height: 100%;"/>
                <div class="card-body">
                    <h4 class="card-title fg-1">{event.data.title}</h4>
                    <small class="fg-1 fs-xs" style="margin-top: -0.5rem;">{event.data.time}</small>
                    <p class="card-text fg-1">{event.data.description}</p>
                </div>
                <div class="card-footer">
                    {event.data.button && <a href={event.data.button.url} class="btn fs-lg fg-2" type="button" style="width: fit-content;">{event.data.button.text}</a> }
                </div>
                </div>
              </div>
            ))}
        </div>
        <div style="height: 3rem;"/>
    </div>
</div>